# Roteamento: auto (Groq -> Ollama), groq ou ollama
AI_PROVIDER=auto

# Groq
# Gere sua chave no painel da Groq e mantenha-a SOMENTE no .env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama local / Android
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=codegemma:instruct

# Histórico por conversa
HISTORY_LIMIT=10
