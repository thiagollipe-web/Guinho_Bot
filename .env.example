# Provedor: auto = Groq primeiro; se falhar, OpenAI
AI_PROVIDER=auto

# Groq (chave somente no servidor/Termux/Vercel, nunca no frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_ENGINEERING=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=1200
CORS_ORIGIN=https://thiagollipe-web.github.io

# Termux
GUINHO_HOST=127.0.0.1
GUINHO_PORT=8787

# Ollama local (fallback offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_MODEL_ENGINEERING=gemma3:270m
