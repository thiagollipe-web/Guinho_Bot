{
  "version": 1,
  "groups": {
    "programacao": [
      "programacao",
      "programação",
      "javascript",
      "typescript",
      "python",
      "html",
      "css",
      "node",
      "github",
      "git",
      "pwa",
      "codigo",
      "código",
      "bug",
      "erro"
    ],
    "sentimentos": [
      "preocupado",
      "confuso",
      "cansado",
      "triste",
      "ansioso",
      "feliz",
      "nervoso"
    ]
  },
  "reflections": {
    "eu": "voce",
    "me": "voce",
    "meu": "seu",
    "minha": "sua",
    "estou": "esta",
    "comigo": "com voce"
  },
  "keywords": [
    {
      "keyword": "erro",
      "precedence": 100,
      "intent": "erro",
      "rules": [
        {
          "decomposition": "* erro *",
          "reassembly": [
            "qual erro apareceu?",
            "me mostre a mensagem exata do erro."
          ]
        },
        {
          "decomposition": "* bug *",
          "reassembly": [
            "vamos localizar o bug. o que aconteceu e o que você esperava?"
          ]
        }
      ]
    },
    {
      "keyword": "ajuda",
      "precedence": 90,
      "intent": "ajuda",
      "rules": [
        {
          "decomposition": "* ajuda *",
          "reassembly": [
            "claro. me diga o que você precisa resolver."
          ]
        }
      ]
    },
    {
      "keyword": "programacao",
      "precedence": 80,
      "intent": "programacao",
      "rules": [
        {
          "decomposition": "* programação *",
          "reassembly": [
            "vamos por partes. o que você quer construir?"
          ]
        },
        {
          "decomposition": "* codigo *",
          "reassembly": [
            "mande o código e diga qual comportamento você espera."
          ]
        }
      ]
    },
    {
      "keyword": "preocupado",
      "precedence": 70,
      "intent": "sentimento",
      "rules": [
        {
          "decomposition": "* preocupado *",
          "reassembly": [
            "o que exatamente está te preocupando?",
            "quer separar esse problema em partes?"
          ]
        }
      ]
    },
    {
      "keyword": "confuso",
      "precedence": 70,
      "intent": "sentimento",
      "rules": [
        {
          "decomposition": "* confuso *",
          "reassembly": [
            "qual parte está confusa para você?",
            "vamos por partes. onde começou a dúvida?"
          ]
        }
      ]
    },
    {
      "keyword": "sou",
      "precedence": 40,
      "intent": "reflexao",
      "rules": [
        {
          "decomposition": "* sou *",
          "reassembly": [
            "o que faz você se descrever assim?"
          ]
        }
      ]
    }
  ],
  "default": [
    "Entendi. Me explique um pouco mais para eu acompanhar.",
    "Certo. Vamos por partes. O que você quer resolver?",
    "Pode continuar. Quero entender melhor o que você está tentando fazer."
  ]
}
